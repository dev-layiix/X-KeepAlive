    <!-- Engine diagnostics shown in the interface -->
    <string name="note_still_in_memory">The game process is still in memory. If the graphics surface was destroyed, the game can still reload on its own.</string>
    <string name="note_terminated">The process seen in the background is gone. Android terminated the game. A new load is expected when you return.</string>
    <string name="note_restarted">The process has a new PID. The previous one died and another was created. The game already reloaded the process.</string>
    <string name="note_not_running">No game process is running.</string>
    <string name="note_not_running_on_leave">Right after moving to the background, the process is not running.</string>
    <string name="note_alive_on_leave">The process is in memory right after you leave. The useful check is when you return to the game.</string>
