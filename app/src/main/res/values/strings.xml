    <!-- Consent dialog -->
    <string name="consent_title">Start monitoring?</string>
    <string name="consent_body">X-KeepAlive reads which app is in the foreground, only to follow the game you chose. The service starts only when Shizuku is installed, running, and authorized. It then uses documented ADB commands: Doze whitelist, standby bucket, idle state, and background app ops, then reads the result back. The game is not started, closed, or controlled.</string>
    <string name="consent_start">Start</string>
    <string name="consent_cancel">Cancel</string>

