    <!-- Setup guide -->
    <string name="guide_title">Setup guide</string>
    <string name="guide_subtitle">Set up Shizuku and X-KeepAlive</string>
    <string name="header_ready_title">You\'re all set!</string>
    <string name="header_progress_title">Almost there!</string>
    <string name="header_desc">Follow the steps to set up Shizuku and enable all features. After a reboot, start Shizuku again.</string>
    <string name="step_locked_hint">Complete the steps above first.</string>
    <string name="step_show_details">Show detailed instructions</string>
    <string name="step_hide_details">Hide detailed instructions</string>
    <string name="tip_label">Tip</string>

    <string name="step_dev_title">Turn on Developer options</string>
    <string name="step_dev_subtitle">Enable required options</string>
    <string name="step_dev_body">Developer options are hidden by default. You unlock them once from About phone. If they are already unlocked, this step is marked as done automatically.</string>
    <string name="step_dev_tip">On Samsung open Software information first. The Developer options menu appears after the toast.</string>
    <string name="step_dev_button">Open About phone</string>

    <string name="step_wifi_title">Turn on Wireless debugging</string>
    <string name="step_wifi_subtitle">Enable wireless debugging</string>
    <string name="step_wifi_body">Shizuku starts through Wireless debugging. Keep your phone on Wi-Fi. The pairing screen must stay open while Shizuku connects.</string>
    <string name="step_wifi_tip">Keep this screen open. Shizuku needs a fresh 6-digit code to pair.</string>
    <string name="step_wifi_button">Open Developer options</string>

    <string name="step_install_title">Install Shizuku</string>
    <string name="step_install_subtitle">From Play Store</string>
    <string name="step_install_body">X-KeepAlive talks to Shizuku, which runs as a local shell service. The service switch stays off until Shizuku is installed.</string>
    <string name="step_install_tip">Install Shizuku by RikkaApps, then come back here.</string>
    <string name="step_install_button">Install Shizuku</string>

    <string name="step_start_title">Start Shizuku</string>
    <string name="step_start_subtitle">Open Shizuku and tap Start</string>
    <string name="step_start_body">Start Shizuku with Wireless debugging. A pairing you made earlier with a computer does not count for the app.</string>
    <string name="step_start_body_legacy">On Android 10 and below there is no Wireless debugging. Start Shizuku from a computer over ADB.</string>
    <string name="step_start_tip">If you already paired Shizuku, just tap Start. You only need to pair again after a reboot.</string>
    <string name="step_start_button">Open Shizuku</string>

    <string name="step_auth_title">Authorize X-KeepAlive</string>
    <string name="step_auth_subtitle">Grant permission in Shizuku</string>
    <string name="step_auth_body">Shizuku asks you once per app. Nothing runs until you allow it. A denial keeps the service off but does not break the app.</string>
    <string name="step_auth_tip">Tap Allow in the Shizuku prompt. A denial keeps the service off.</string>
    <string name="step_auth_button">Authorize Shizuku</string>

    <string name="step_usage_title">Allow usage access</string>
    <string name="step_usage_subtitle">For better stability</string>
    <string name="step_usage_body">X-KeepAlive reads which app is in the foreground so it follows only the games you switch on. Nothing else is tracked.</string>
    <string name="step_usage_tip">Find X-KeepAlive in the list and turn the switch on.</string>
    <string name="step_usage_button">Open usage access</string>

    <string name="step_notif_title">Allow notifications</string>
    <string name="step_notif_subtitle">To receive events</string>
    <string name="step_notif_body">Android only keeps the foreground service alive while its notification is visible. Without it the system stops monitoring.</string>
    <string name="step_notif_tip">Android stops the service without its notification.</string>
    <string name="step_notif_button">Allow notification</string>

    <string name="step_power_title">Set the X-KeepAlive battery</string>
    <string name="step_power_subtitle">Keep monitoring alive</string>
    <string name="step_power_body">Android can pause X-KeepAlive itself to save battery. Setting it to Unrestricted keeps the monitoring service running.</string>
    <string name="step_power_tip">Choose Unrestricted so Android does not pause monitoring.</string>
    <string name="step_power_button">Open battery settings</string>

    <string name="step_gamebatt_title">Set the game battery</string>
    <string name="step_gamebatt_subtitle">Allow background activity</string>
    <string name="step_gamebatt_body">Each game also needs Unrestricted battery, or Android stops it in the background no matter what. Adding a game now opens its settings automatically.</string>
    <string name="step_gamebatt_tip">Set every game to Unrestricted, one by one.</string>
    <string name="step_gamebatt_button">Open game settings</string>

    <string name="step_apps_title">Choose apps to keep</string>
    <string name="step_apps_subtitle">Select up to 4 games or apps</string>
    <string name="step_apps_body">Add the games or apps you switch between. Each row shows its icon and a switch. Only 4 can be active at once.</string>
    <string name="step_apps_tip">Turn on up to 4 switches on Home. The rest stay off.</string>
    <string name="step_apps_button">Open Home</string>

    <string name="step_service_title">Enable monitoring service</string>
    <string name="step_service_subtitle">Turn on the service</string>
    <string name="step_service_body">The switch next to the counter on Home starts and stops everything. It stays off until all steps above are done.</string>
    <string name="step_service_tip">Use the switch next to the counter on Home, then accept the prompt.</string>
    <string name="step_service_button">Open Home</string>

    <!-- Info cards -->
    <string name="info_reboot_title">After a reboot</string>
    <string name="info_reboot_body">Wireless debugging and Shizuku turn off. Open Shizuku and tap Start, then return here.</string>
    <string name="info_battery_title">Battery settings</string>
    <string name="info_battery_body">Set X-KeepAlive and your games to Unrestricted to prevent Android from stopping them.</string>
    <string name="info_cannot_title">What it cannot do</string>
    <string name="info_cannot_body">It does not play for you, simulate taps, or use an accessibility service. It only keeps selected apps active.</string>
    <string name="info_privacy_title">Privacy</string>
    <string name="info_privacy_body">Your selection and event log stay on the phone. No account is required and no data is sent to any server.</string>

    <!-- Good to know -->
    <string name="gtk_title">Good to know</string>
    <string name="gtk_subtitle">Important information and FAQs</string>
    <string name="gtk_dev">If Developer options are missing: open Settings, About phone, then Software information (Samsung, Xiaomi), and tap Build number 7 times.</string>
    <string name="gtk_pair">A pairing made with a computer does not count for the app. Pair Shizuku itself through Wireless debugging.</string>
    <string name="gtk_deny">Denying a permission only keeps the service off. The app stays usable and you can allow it later.</string>

