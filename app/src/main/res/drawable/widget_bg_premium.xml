<?xml version="1.0" encoding="utf-8"?>
<!-- Deep night-blue gradient with a thin luminous edge. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="28dp" />
    <gradient
        android:angle="135"
        android:startColor="#E60D1626"
        android:centerColor="#D6080F1D"
        android:endColor="#E604070E" />
    <stroke android:width="1dp" android:color="#3D5A80" />
</shape>
